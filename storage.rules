rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Imagens de produtos e do catálogo
    // - Leitura pública: qualquer visitante pode ver as fotos das fragrâncias
    // - Upload e exclusão: restrito ao administrador autenticado
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Regra padrão para demais arquivos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

